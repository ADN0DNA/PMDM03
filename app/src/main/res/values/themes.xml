<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.MyFragments" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Colores principales -->
        <item name="colorPrimary">@color/turquoise_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/turquoise_light</item>
        <item name="colorOnPrimaryContainer">@color/turquoise_dark</item>

        <!-- Colores secundarios -->
        <item name="colorSecondary">@color/teal_secondary</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSecondaryContainer">@color/teal_light</item>
        <item name="colorOnSecondaryContainer">@color/teal_dark</item>

        <!-- Colores terciarios -->
        <item name="colorTertiary">@color/cyan_tertiary</item>
        <item name="colorOnTertiary">@color/white</item>
        <item name="colorTertiaryContainer">@color/cyan_light</item>
        <item name="colorOnTertiaryContainer">@color/cyan_dark</item>

        <!-- Superficie y fondo -->
        <item name="colorSurface">@color/surface_light</item>
        <item name="colorOnSurface">@color/black</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/on_surface_variant</item>

        <!-- Otros colores -->
        <item name="colorError">@color/error</item>
        <item name="colorOnError">@color/white</item>
    </style>

    <style name="Theme.MyFragments" parent="Base.Theme.MyFragments" />
</resources>
