<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/listFragment">

    <fragment
        android:id="@+id/listFragment"
        android:name="com.example.myfragments.ui.scps.ListFragment"
        android:label="fragment_list"
        tools:layout="@layout/fragment_list" >
        <action
            android:id="@+id/action_listFragment_to_fragmentEditar"
            app:destination="@id/fragmentEditar" />
        <action
            android:id="@+id/action_listFragment_to_fragmentAdd"
            app:destination="@id/fragmentAdd" />
    </fragment>
    <fragment
        android:id="@+id/fragmentEditar"
        android:name="com.example.myfragments.ui.scps.editar.FragmentScpsEditar"
        android:label="fragment_editar"
        tools:layout="@layout/fragment_editar" >
        <argument
            android:name="scpId"
            app:argType="integer"
            android:defaultValue="-1" />
    </fragment>
    <fragment
        android:id="@+id/fragmentAdd"
        android:name="com.example.myfragments.ui.scps.add.FragmentScpsAdd"
        android:label="fragment_add"
        tools:layout="@layout/fragment_add" />
    <fragment
        android:id="@+id/sitesListFragment"
        android:name="com.example.myfragments.ui.sites.SitesListFragment"
        android:label="fragment_sites_list"
        tools:layout="@layout/fragment_sites_list" >
        <action
            android:id="@+id/action_sitesListFragment_to_fragmentSitesEditar"
            app:destination="@id/fragmentSitesEditar" />
        <action
            android:id="@+id/action_sitesListFragment_to_fragmentSitesAdd"
            app:destination="@id/fragmentSitesAdd" />
    </fragment>
    <fragment
        android:id="@+id/fragmentSitesAdd"
        android:name="com.example.myfragments.ui.sites.add.FragmentSitesAdd"
        android:label="fragment_sites_add"
        tools:layout="@layout/fragment_sites_add" />
    <fragment
        android:id="@+id/fragmentSitesEditar"
        android:name="com.example.myfragments.ui.sites.editar.FragmentSitesEditar"
        android:label="fragment_sites_editar"
        tools:layout="@layout/fragment_sites_editar" >
        <argument
            android:name="siteId"
            app:argType="integer"
            android:defaultValue="-1" />
    </fragment>
</navigation>